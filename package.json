{
  "name": "pocketosix",
  "version": "0.0.1",
  "private": true,
  "description": "Real unix vibe right in your browser. A persistent Alpine / i3 desktop powered by CheerpX.",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "desktop": "node scripts/open-desktop.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test --project=chromium",
    "test:vm": "playwright test --project=real-vm"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@leaningtech/cheerpx": "1.4.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
