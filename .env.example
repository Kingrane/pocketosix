# The official, immutable Alpine / Xorg / i3 image is used by default.
# No environment variables or credentials are required to start the desktop.
# For a custom image, set ALL THREE values and use a NEW disk ID.
# Never point an existing persistent overlay at a different base image.
# NEXT_PUBLIC_DISK_URL=https://your-image-host.example/alpine.ext2
# NEXT_PUBLIC_DISK_BACKEND=bytes
# NEXT_PUBLIC_DISK_ID=pocketosix-my-alpine-v1
# Never put Tailscale auth keys in NEXT_PUBLIC_* variables.
# Set the actual publication origin for OG/Twitter, robots and sitemap.
# SITE_URL=https://your-site.example
# Without SITE_URL, Vercel's production domain is used, otherwise localhost:3000.
